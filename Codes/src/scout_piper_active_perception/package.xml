<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scout_piper_active_perception</name>
  <version>0.0.1</version>
  <description>Phase 4 active perception: next view for the wrist camera from the stem joint's Fisher information, approach-corridor coverage and the JEPA / plant_twin uncertainty; reachable view candidates for the whole-body MPC; VGGT sparse-view depth helpers; simulated benchmark.</description>
  <maintainer email="tuananh05253@gmail.com">Vu Tuan Anh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>scout_piper_scene_repr</exec_depend>
  <exec_depend>scout_piper_whole_body_mpc</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- VGGT (facebookresearch/vggt) and torch are installed in the GPU environment, not via rosdep -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
