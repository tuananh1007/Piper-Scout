<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scout_piper_language</name>
  <version>0.0.1</version>
  <description>Phase 5 operator layer: instruction parser and grounding in the stem_grasp detections, optional VLM proposer behind HTTP, reachability filter with plain-language reasons, 2-s confirmation countdown, software stop, and the operator web GUI (Command / Inspect / Drive / Watch).</description>
  <maintainer email="tuananh05253@gmail.com">Vu Tuan Anh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>scout_piper_scene_repr</exec_depend>
  <exec_depend>scout_piper_whole_body_mpc</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- optional: whisper-cpp and Piper TTS binaries for voice (operator_gui_node whisper_cmd / tts_cmd) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
