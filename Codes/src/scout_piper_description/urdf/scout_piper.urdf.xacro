<?xml version="1.0"?>
<robot name="scout_piper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Unified URDF for AgileX Piper 6-DoF arm mounted on Scout 2.0 UGV with an
    eye-in-hand RealSense D435.

    Composes three subtrees:
      1. Scout 2.0 base       — upstream scout_description (root link: base_link)
      2. Piper arm + gripper  — forked piper_description, prefixed `piper_` and
                                wrapped in a macro (see _piper_arm.xacro)
      3. RealSense D435       — upstream realsense2_description, mounted on
                                piper_link6 (the EE flange)

    TF tree:
      odom -> base_link (Scout) -> piper_mount_link -> piper_base_link
              -> piper_link1 -> ... -> piper_link6 -> camera_link
                                                  \-> piper_gripper_base
                                                        \-> piper_link7
                                                        \-> piper_link8
  -->

  <xacro:arg name="use_sim"        default="false"/>
  <xacro:arg name="use_gazebo_ros" default="false"/>

  <!-- Eye-in-hand camera placement on the EE flange. Override at launch
       once hand-eye calibration is done. -->
  <xacro:arg name="cam_xyz" default="0.05 0.0 0.05"/>
  <xacro:arg name="cam_rpy" default="0.0 0.0 0.0"/>

  <!-- =========================================================== -->
  <!-- 1. Scout 2.0 base                                            -->
  <!-- =========================================================== -->
  <xacro:include filename="$(find scout_description)/urdf/scout_v2.xacro"/>

  <!-- =========================================================== -->
  <!-- 2. Piper mount plate (placeholder; tune to physical mount)   -->
  <!-- =========================================================== -->
  <link name="piper_mount_link">
    <visual>
      <geometry><box size="0.08 0.08 0.01"/></geometry>
      <material name="aluminum"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="scout_to_piper_mount" type="fixed">
    <parent link="base_link"/>
    <child  link="piper_mount_link"/>
    <origin xyz="0.15 0.0 0.18" rpy="0 0 0"/>
  </joint>

  <!-- =========================================================== -->
  <!-- 3. Piper 6-DoF arm + gripper (forked macro)                  -->
  <!-- =========================================================== -->
  <xacro:include filename="$(find scout_piper_description)/urdf/_piper_arm.xacro"/>

  <xacro:piper_arm prefix="piper_" parent="piper_mount_link">
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </xacro:piper_arm>

  <!-- =========================================================== -->
  <!-- 4. RealSense D435 (eye-in-hand on the EE flange)             -->
  <!-- =========================================================== -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

  <xacro:sensor_d435 name="camera" parent="piper_link6" use_nominal_extrinsics="true">
    <origin xyz="$(arg cam_xyz)" rpy="$(arg cam_rpy)"/>
  </xacro:sensor_d435>

</robot>
