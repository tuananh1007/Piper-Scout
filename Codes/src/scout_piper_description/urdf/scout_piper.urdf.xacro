<?xml version="1.0"?>
<robot name="scout_piper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Unified URDF for AgileX Piper 6-DoF arm mounted on Scout 2.0 UGV.

    STATUS (2026-05-17):
      v0 — Scout-only. The upstream agilexrobotics/piper_ros@humble ships a
      piper_description.xacro that hardcodes its root as <link name="base_link"/>
      AND defines a <link name="world"/> with a fixed joint to base_link. There
      is no `prefix` argument on the upstream xacro, so xacro:include-ing it
      alongside scout_v2.xacro produces a duplicate-link error.

    TODO(P0.2.3): Fork piper_description.xacro into our own
      scout_piper_description/urdf/_piper_arm.xacro with:
        - all links prefixed (e.g., piper_base_link, piper_link1, …, piper_link6)
        - the upstream world link + fixed_base_joint removed
        - the upstream <link name="base_link"> renamed to piper_base_link
      Then mount it on Scout via a fixed joint from base_link → piper_mount_link
      → piper_base_link.

    This v0 keeps view_robot.launch.py functional (you can verify the Scout
    chassis + RealSense mount frame) while we sort out the arm integration.
  -->

  <xacro:arg name="use_sim"        default="false"/>
  <xacro:arg name="use_gazebo_ros" default="false"/>

  <!-- Scout 2.0 base -->
  <xacro:include filename="$(find scout_description)/urdf/scout_v2.xacro"/>

  <!-- Piper mount plate (placeholder; tune dimensions to match the physical mount) -->
  <xacro:property name="piper_mount_xyz" value="0.15 0.0 0.18"/>
  <xacro:property name="piper_mount_rpy" value="0.0 0.0 0.0"/>

  <link name="piper_mount_link">
    <visual>
      <geometry><box size="0.08 0.08 0.01"/></geometry>
      <material name="aluminum"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="scout_to_piper_mount" type="fixed">
    <parent link="base_link"/>
    <child  link="piper_mount_link"/>
    <origin xyz="${piper_mount_xyz}" rpy="${piper_mount_rpy}"/>
  </joint>

  <!-- RealSense D435 (eye-in-hand placeholder until P0.2.3 is done). Mounted
       on piper_mount_link for now so RViz shows a sensible camera frame. -->
  <xacro:arg name="cam_xyz" default="0.05 0.0 0.05"/>
  <xacro:arg name="cam_rpy" default="0.0 0.0 0.0"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
  <xacro:sensor_d435 name="camera" parent="piper_mount_link" use_nominal_extrinsics="true">
    <origin xyz="$(arg cam_xyz)" rpy="$(arg cam_rpy)"/>
  </xacro:sensor_d435>

</robot>
