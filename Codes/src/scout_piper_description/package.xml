<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scout_piper_description</name>
  <version>0.0.1</version>
  <description>Unified URDF/xacro for the AgileX Piper 6-DoF arm mounted on a Scout 2.0 UGV, plus RealSense camera mount. Composes the upstream piper_description and scout_description packages.</description>
  <maintainer email="sciarm@todo.todo">sciarm</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- These come from the vcs-imported upstream packages. -->
  <exec_depend>piper_description</exec_depend>
  <exec_depend>scout_description</exec_depend>
  <exec_depend>realsense2_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
